<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>manipulation_execution_manager</name>
  <version>0.1.0</version>
  <description>Generic execution manager for manipulation controllers — source gate, decoder, normalizer, reference publishing.</description>
  <maintainer email="guomning@gmail.com">Gabriel-Ning</maintainer>
  <author email="guomning@gmail.com">Gabriel-Ning</author>
  <license>Apache-2.0</license>
  <url type="repository">https://github.com/Gabriel-Ning/manipulation_execution_manager</url>
  <url type="bugtracker">https://github.com/Gabriel-Ning/manipulation_execution_manager/issues</url>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-setuptools</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <depend>action_msgs</depend>
  <depend>control_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>python3-numpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>trajectory_msgs</depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
