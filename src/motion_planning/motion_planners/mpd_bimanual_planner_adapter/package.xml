  <version>0.1.0</version>
  <description>Isolated 14-joint Marvin MPD planner adapter.</description>
  <maintainer email="guomning@gmail.com">Physical AI Runtime</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
